<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same as backup_rules.xml, for both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <exclude domain="database" path="freedict_eng_rus.db" />
        <include domain="sharedpref" path="wordly_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="database" path="freedict_eng_rus.db" />
        <include domain="sharedpref" path="wordly_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
